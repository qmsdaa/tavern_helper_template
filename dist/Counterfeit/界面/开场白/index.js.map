export default {title:{lines:[{segments:[{text:'やはり',color:'#4aa8dd'},{text:'俺',color:'#f0679f'},{text:'の',color:'#4aa8dd'},{text:'青春ラブコメは',color:'#f0679f'}]},{segments:[{text:'まちがって',color:'#4aa8dd'},{text:'いる',color:'#f0679f'},{text:'。',color:'#4aa8dd'}]}],subtitle:'Counterfeit'},modes:{story:{label:'剧本模式',desc:'150场主线·沿剧本日历推进的青春物语'},open:{label:'开放世界',desc:'无剧本自由扮演·角色按各自日程生活·关系由你经营'}},povs:[{key:'hachiman',name:'比企谷八幡',portrait:'hachiman.webp',role:'地面',tagline:'自称孤狼的二年级生。温柔藏在死鱼眼和歪理后面，喜欢的饮料是MAX咖啡。'},{key:'yukino',name:'雪之下雪乃',portrait:'yukino.webp',role:'灯塔',tagline:'奉仕部部长，完美主义者。最近开始学习「正确」以外的东西。'},{key:'yui',name:'由比滨结衣',portrait:'yui.webp',role:'温度',tagline:'奉仕部的气氛守护者。她的笑容是这间部室里不变的热可可。'},{key:'laff',name:'拉芙希妮·都柏林',portrait:'laff.webp',role:'火',tagline:'来自都柏林的转学生。笑容像治愈的天使，右手腕系着尾端烧焦的旧丝带。',exclusive:'家族线 · 真相路线'}],openings:{hachiman:'五月二十日，星期一。课间，户部他们挤在走廊上议论，说J班转来了一个金发的英国美女。\n我，比企谷八幡，原本只想安静地腐烂在教室角落，却在那一刻预感到——我的青春恋爱物语，又要出问题了。',yukino:'五月的早晨，第一节课前的教室还有些松散。班主任领着一位金发的转学生站上讲台，说她来自英国。\n雪之下雪乃坐在靠窗的座位上，看着那个整洁得过分的新生走向自己身旁的空位——右手腕上，一条尾端烧焦的旧丝带。她隐约觉得，自己一贯正确的世界里，多了一个无法归类的存在。',yui:'那天风特别大，窗帘被吹得哗啦啦作响。班里不知谁先提起——隔壁J班来了个英国转学生。「听说是金发的。」「长得超漂亮。」「但是感觉很难接近诶。」\n由比滨结衣趴在桌上听着，忍不住偷偷往窗外看了一眼。「下课要不要去看看？」她刚这么说，就被旁边的优美子笑着拉住：「那种类型的人，搭话了也会被冷淡回应吧？」「诶……有那么夸张吗？」她嘴上这么说，手指却轻轻敲着桌面，没有真的放弃这个念头。\n不好接近，到底是什么意思呢？是讨厌别人靠近，还是只是……不知道该怎么和别人相处？那时候的由比滨结衣还不知道——有些相遇并不是因为一开始就特别重要，只是因为某个人先伸出了手，后来的一切才慢慢有了意义。',laff:'2013年5月20日，都柏林来的火种第一次站进总武高中的教室。黑板前，全班的视线落在她身上。\n拉芙希妮·都柏林理了理袖口的旧丝带，心想：那么，就和以前一样。',custom:'2013年5月20日，{{姓名}}站在总武高中的走廊上，看着校园小路上熙熙攘攘的人群。\n那时的{{姓名}}还不知道，自己即将被卷入一场关于真心与伪物的、拙劣又真诚的青春物语。'},gallery:{title:'画廊',hint:'悬停可暂停放映 · 点击胶片帧放大',items:[{title:'场景 CG 01',caption:'占位 · 待作者补充',image:null},{title:'场景 CG 02',caption:'占位 · 待作者补充',image:null},{title:'场景 CG 03',caption:'占位 · 待作者补充',image:null},{title:'场景 CG 04',caption:'占位 · 待作者补充',image:null},{title:'场景 CG 05',caption:'占位 · 待作者补充',image:null},{title:'场景 CG 06',caption:'占位 · 待作者补充',image:null}]}};